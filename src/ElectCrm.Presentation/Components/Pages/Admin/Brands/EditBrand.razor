@rendermode InteractiveServer
@page "/admin/brands/{Id:guid}/edit"
@layout AdminLayout
@attribute [Authorize(Policy = PolicyNames.GroupAdmin)]
@inject AgencyBrandAdminService AgencyBrandAdminService
@inject NavigationManager NavigationManager

<PageTitle>Edit Brand — Admin — Elect CRM</PageTitle>

<a href="/admin/brands/@Id" class="back-link">← Brand Detail</a>

<div class="page-header">
    <h1 class="page-header-title">Edit Brand</h1>
</div>

@if (_errorMessage is not null)
{
    <div class="elect-alert elect-alert-error" role="alert">@_errorMessage</div>
}

@if (_isLoading)
{
    <p>Loading…</p>
}
else if (_model is not null)
{
    <div class="elect-form-card" style="max-width: 720px;">
        <div style="margin-bottom: var(--space-6); padding-bottom: var(--space-6); border-bottom: 1px solid var(--border-1);">
            <p class="elect-form-section-title">Legal Identifier</p>
            <div class="elect-detail-grid" style="margin-top: var(--space-3);">
                <span class="elect-detail-label">Companies House</span>
                <span class="elect-detail-value" style="font-family: monospace;">@_companiesHouseNumber</span>
            </div>
            <small style="color: var(--fg-2); font-size: 0.8125rem;">Companies House number cannot be changed — it is the legal identifier for this brand.</small>
        </div>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <p class="elect-form-section-title">Legal Identity</p>
            <div class="elect-form-section">
                <div class="elect-field">
                    <label class="elect-label" for="legalName">Legal Name</label>
                    <InputText id="legalName" class="elect-input" @bind-Value="_model.LegalName" />
                    <ValidationMessage For="() => _model.LegalName" class="elect-validation-message" />
                </div>

                <div class="elect-field">
                    <label class="elect-label" for="tradingName">Trading Name</label>
                    <InputText id="tradingName" class="elect-input" @bind-Value="_model.TradingName" />
                    <ValidationMessage For="() => _model.TradingName" class="elect-validation-message" />
                </div>
            </div>

            <div class="elect-form-section">
                <p class="elect-form-section-title">Regulatory</p>
                <div class="elect-field">
                    <label class="elect-label" for="vatNumber">VAT Number (optional)</label>
                    <InputText id="vatNumber" class="elect-input" @bind-Value="_model.VatNumber" />
                </div>

                <div class="elect-field">
                    <label class="elect-label" for="glaaLicenceNumber">GLAA Licence Number (optional)</label>
                    <InputText id="glaaLicenceNumber" class="elect-input" @bind-Value="_model.GlaaLicenceNumber" />
                </div>

                <div class="elect-field">
                    <label class="elect-label" for="primaryContactEmail">Primary Contact Email</label>
                    <InputText id="primaryContactEmail" class="elect-input" type="email" @bind-Value="_model.PrimaryContactEmail" />
                    <ValidationMessage For="() => _model.PrimaryContactEmail" class="elect-validation-message" />
                </div>

                <div class="elect-field">
                    <label class="elect-label" for="agentPersonaName">Agent Persona Name (optional)</label>
                    <InputText id="agentPersonaName" class="elect-input" @bind-Value="_model.AgentPersonaName" />
                    <small style="color: var(--fg-2); font-size: 0.8125rem;">Name used by the AI engagement agent for this brand.</small>
                </div>
            </div>

            <div class="elect-form-section">
                <p class="elect-form-section-title">Registered Address</p>
                <div class="elect-field">
                    <label class="elect-label" for="addrLine1">Line 1</label>
                    <InputText id="addrLine1" class="elect-input" @bind-Value="_model.AddressLine1" />
                    <ValidationMessage For="() => _model.AddressLine1" class="elect-validation-message" />
                </div>

                <div class="elect-field">
                    <label class="elect-label" for="addrLine2">Line 2 (optional)</label>
                    <InputText id="addrLine2" class="elect-input" @bind-Value="_model.AddressLine2" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div class="elect-field">
                        <label class="elect-label" for="addrCity">City</label>
                        <InputText id="addrCity" class="elect-input" @bind-Value="_model.AddressCity" />
                        <ValidationMessage For="() => _model.AddressCity" class="elect-validation-message" />
                    </div>
                    <div class="elect-field">
                        <label class="elect-label" for="addrCounty">County (optional)</label>
                        <InputText id="addrCounty" class="elect-input" @bind-Value="_model.AddressCounty" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div class="elect-field">
                        <label class="elect-label" for="addrPostcode">Postcode</label>
                        <InputText id="addrPostcode" class="elect-input" @bind-Value="_model.AddressPostcode" />
                        <ValidationMessage For="() => _model.AddressPostcode" class="elect-validation-message" />
                    </div>
                    <div class="elect-field">
                        <label class="elect-label" for="addrCountry">Country</label>
                        <InputText id="addrCountry" class="elect-input" @bind-Value="_model.AddressCountry" maxlength="2" />
                        <ValidationMessage For="() => _model.AddressCountry" class="elect-validation-message" />
                    </div>
                </div>
            </div>

            <div class="elect-form-section">
                <p class="elect-form-section-title">Group Linkage (optional)</p>
                <div class="elect-field">
                    <label class="elect-label" for="parentGroup">Parent Group</label>
                    <InputSelect id="parentGroup" class="elect-input" @bind-Value="_model.ParentGroupIdRaw">
                        <option value="">None (standalone brand)</option>
                        @foreach (var brand in _allBrands.Where(b => b.Id != Id))
                        {
                            <option value="@brand.Id">@brand.TradingName</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="elect-form-actions">
                <button type="submit" class="btn-gold-sm" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Saving…" : "Save Changes")
                </button>
                <a href="/admin/brands/@Id" class="btn-outline">Cancel</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BrandEditModel? _model;
    private string _companiesHouseNumber = string.Empty;
    private IReadOnlyList<AgencyBrandSummaryDto> _allBrands = [];
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var allResult = await AgencyBrandAdminService.GetAllAsync(CancellationToken.None);
        if (allResult.IsSuccess)
            _allBrands = allResult.Value;

        var detailResult = await AgencyBrandAdminService.GetByIdAsync(Id, CancellationToken.None);

        if (detailResult.IsFailure)
        {
            NavigationManager.NavigateTo("/admin/brands");
            return;
        }

        var brand = detailResult.Value;
        _companiesHouseNumber = brand.CompaniesHouseNumber;

        _model = new BrandEditModel
        {
            LegalName = brand.LegalName,
            TradingName = brand.TradingName,
            VatNumber = brand.VatNumber,
            GlaaLicenceNumber = brand.GlaaLicenceNumber,
            PrimaryContactEmail = brand.PrimaryContactEmail,
            AddressLine1 = brand.RegisteredAddress.Line1,
            AddressLine2 = brand.RegisteredAddress.Line2,
            AddressCity = brand.RegisteredAddress.City,
            AddressCounty = brand.RegisteredAddress.County,
            AddressPostcode = brand.RegisteredAddress.Postcode,
            AddressCountry = brand.RegisteredAddress.Country,
            ParentGroupIdRaw = brand.ParentGroupId?.ToString(),
        };

        _isLoading = false;
    }

    private async Task SubmitAsync()
    {
        if (_model is null)
            return;

        _isSubmitting = true;
        _errorMessage = null;

        Address address;
        try
        {
            address = new Address(
                _model.AddressLine1,
                _model.AddressCity,
                _model.AddressPostcode,
                string.IsNullOrWhiteSpace(_model.AddressLine2) ? null : _model.AddressLine2,
                string.IsNullOrWhiteSpace(_model.AddressCounty) ? null : _model.AddressCounty,
                string.IsNullOrWhiteSpace(_model.AddressCountry) ? "GB" : _model.AddressCountry);
        }
        catch (ArgumentException ex)
        {
            _errorMessage = ex.Message;
            _isSubmitting = false;
            return;
        }

        Guid? parentGroupId = Guid.TryParse(_model.ParentGroupIdRaw, out var pg) ? pg : null;

        var command = new UpdateAgencyBrandCommand(
            Id,
            _model.LegalName,
            _model.TradingName,
            string.IsNullOrWhiteSpace(_model.VatNumber) ? null : _model.VatNumber,
            string.IsNullOrWhiteSpace(_model.GlaaLicenceNumber) ? null : _model.GlaaLicenceNumber,
            address,
            _model.PrimaryContactEmail,
            string.IsNullOrWhiteSpace(_model.AgentPersonaName) ? null : _model.AgentPersonaName,
            parentGroupId);

        var result = await AgencyBrandAdminService.UpdateAsync(command, CancellationToken.None);

        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo($"/admin/brands/{Id}");
            return;
        }

        _errorMessage = result.Error.Message;
        _isSubmitting = false;
    }

    private sealed class BrandEditModel
    {
        [Required(ErrorMessage = "Legal name is required.")]
        [MaxLength(200)]
        public string LegalName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Trading name is required.")]
        [MaxLength(200)]
        public string TradingName { get; set; } = string.Empty;

        [MaxLength(20)]
        public string? VatNumber { get; set; }

        [MaxLength(50)]
        public string? GlaaLicenceNumber { get; set; }

        [Required(ErrorMessage = "Primary contact email is required.")]
        [MaxLength(200)]
        [EmailAddress]
        public string PrimaryContactEmail { get; set; } = string.Empty;

        [MaxLength(200)]
        public string? AgentPersonaName { get; set; }

        [Required(ErrorMessage = "Address line 1 is required.")]
        [MaxLength(200)]
        public string AddressLine1 { get; set; } = string.Empty;

        [MaxLength(200)]
        public string? AddressLine2 { get; set; }

        [Required(ErrorMessage = "City is required.")]
        [MaxLength(100)]
        public string AddressCity { get; set; } = string.Empty;

        [MaxLength(100)]
        public string? AddressCounty { get; set; }

        [Required(ErrorMessage = "Postcode is required.")]
        [MaxLength(10)]
        public string AddressPostcode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Country is required.")]
        [MaxLength(2)]
        public string AddressCountry { get; set; } = "GB";

        public string? ParentGroupIdRaw { get; set; }
    }
}
