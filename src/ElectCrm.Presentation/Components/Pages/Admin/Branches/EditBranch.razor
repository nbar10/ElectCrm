@rendermode InteractiveServer
@page "/admin/brands/{BrandId:guid}/branches/{BranchId:guid}/edit"
@layout AdminLayout
@attribute [Authorize(Policy = PolicyNames.GroupAdmin)]
@inject BranchAdminService BranchAdminService
@inject NavigationManager NavigationManager

<PageTitle>Edit Branch — Admin — Elect CRM</PageTitle>

<a href="/admin/brands/@BrandId/branches" class="back-link">← Branches</a>

<div class="page-header">
    <h1 class="page-header-title">Edit Branch</h1>
</div>

@if (_errorMessage is not null)
{
    <div class="elect-alert elect-alert-error" role="alert">@_errorMessage</div>
}

@if (_successMessage is not null)
{
    <div class="elect-alert elect-alert-success" role="status">@_successMessage</div>
}

@if (_confirmRetire)
{
    <div class="elect-confirm-row">
        <span class="elect-confirm-row-msg">
            Retire this branch? Any users assigned here will need reassigning.
        </span>
        <button class="btn-danger" @onclick="ConfirmRetireAsync" disabled="@_isWorking">Confirm Retire</button>
        <button class="btn-outline" @onclick="() => _confirmRetire = false">Cancel</button>
    </div>
}

@if (_isLoading)
{
    <p>Loading…</p>
}
else if (_model is not null && _branch is not null)
{
    <div class="elect-form-card" style="max-width: 720px;">
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <p class="elect-form-section-title">Identity</p>
            <div class="elect-form-section">
                <div class="elect-field">
                    <label class="elect-label" for="name">Branch Name</label>
                    <InputText id="name" class="elect-input" @bind-Value="_model.Name" />
                    <ValidationMessage For="() => _model.Name" class="elect-validation-message" />
                </div>
            </div>

            <div class="elect-form-section">
                <p class="elect-form-section-title">Address</p>
                <div class="elect-field">
                    <label class="elect-label" for="addrLine1">Line 1</label>
                    <InputText id="addrLine1" class="elect-input" @bind-Value="_model.AddressLine1" />
                    <ValidationMessage For="() => _model.AddressLine1" class="elect-validation-message" />
                </div>

                <div class="elect-field">
                    <label class="elect-label" for="addrLine2">Line 2 (optional)</label>
                    <InputText id="addrLine2" class="elect-input" @bind-Value="_model.AddressLine2" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div class="elect-field">
                        <label class="elect-label" for="addrCity">City</label>
                        <InputText id="addrCity" class="elect-input" @bind-Value="_model.AddressCity" />
                        <ValidationMessage For="() => _model.AddressCity" class="elect-validation-message" />
                    </div>
                    <div class="elect-field">
                        <label class="elect-label" for="addrCounty">County (optional)</label>
                        <InputText id="addrCounty" class="elect-input" @bind-Value="_model.AddressCounty" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div class="elect-field">
                        <label class="elect-label" for="addrPostcode">Postcode</label>
                        <InputText id="addrPostcode" class="elect-input" @bind-Value="_model.AddressPostcode" />
                        <ValidationMessage For="() => _model.AddressPostcode" class="elect-validation-message" />
                    </div>
                    <div class="elect-field">
                        <label class="elect-label" for="addrCountry">Country</label>
                        <InputText id="addrCountry" class="elect-input" @bind-Value="_model.AddressCountry" maxlength="2" />
                        <ValidationMessage For="() => _model.AddressCountry" class="elect-validation-message" />
                    </div>
                </div>
            </div>

            <div class="elect-form-section">
                <p class="elect-form-section-title">Geography</p>
                <div class="elect-field">
                    <label class="elect-label" for="postcodePrefixes">Postcode Prefixes (optional)</label>
                    @* DS-GAP-001 — no tag-input component; using comma-separated textarea workaround *@
                    <textarea id="postcodePrefixes" class="elect-input" rows="2"
                              @bind="_model.PostcodePrefixesRaw"></textarea>
                    <small style="color: var(--fg-2); font-size: 0.8125rem;">
                        Enter outward postcode prefixes separated by commas, e.g. EC1, SW, E14
                    </small>
                </div>
            </div>

            <div class="elect-form-actions">
                <button type="submit" class="btn-gold-sm" disabled="@_isWorking">
                    @(_isWorking ? "Saving…" : "Save Changes")
                </button>
                <a href="/admin/brands/@BrandId/branches" class="btn-outline">Cancel</a>
            </div>
        </EditForm>
    </div>

    <div class="elect-detail-card" style="max-width: 720px; margin-top: var(--space-6);">
        <div class="elect-contact-header">
            <div class="elect-contact-header-info">
                <h2 class="elect-contact-name">Status</h2>
                <p class="elect-contact-role">Current: @_branch.Status</p>
            </div>
            <span class="elect-badge @(_branch.Status == BranchStatus.Active ? "elect-badge-active" : "elect-badge-retired")">
                @_branch.Status
            </span>
        </div>
        <div class="elect-detail-body">
            @if (_branch.Status == BranchStatus.Active)
            {
                <button class="btn-danger" @onclick="() => _confirmRetire = true" disabled="@_isWorking">
                    Retire Branch
                </button>
            }
            @if (_branch.Status == BranchStatus.Retired)
            {
                <button class="btn-dark" @onclick="ReactivateAsync" disabled="@_isWorking">
                    Reactivate Branch
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid BrandId { get; set; }
    [Parameter] public Guid BranchId { get; set; }

    private BranchEditModel? _model;
    private BranchDetailDto? _branch;
    private bool _isLoading = true;
    private bool _isWorking;
    private bool _confirmRetire;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await BranchAdminService.GetByIdAsync(BranchId, CancellationToken.None);

        if (result.IsFailure)
        {
            NavigationManager.NavigateTo($"/admin/brands/{BrandId}/branches");
            return;
        }

        _branch = result.Value;

        _model = new BranchEditModel
        {
            Name = _branch.Name,
            AddressLine1 = _branch.Address.Line1,
            AddressLine2 = _branch.Address.Line2,
            AddressCity = _branch.Address.City,
            AddressCounty = _branch.Address.County,
            AddressPostcode = _branch.Address.Postcode,
            AddressCountry = _branch.Address.Country,
            PostcodePrefixesRaw = _branch.Geography.PostcodePrefixes.Count > 0
                ? string.Join(", ", _branch.Geography.PostcodePrefixes)
                : null
        };

        _isLoading = false;
    }

    private async Task SubmitAsync()
    {
        if (_model is null)
            return;

        _isWorking = true;
        _errorMessage = null;
        _successMessage = null;

        Address address;
        try
        {
            address = new Address(
                _model.AddressLine1,
                _model.AddressCity,
                _model.AddressPostcode,
                string.IsNullOrWhiteSpace(_model.AddressLine2) ? null : _model.AddressLine2,
                string.IsNullOrWhiteSpace(_model.AddressCounty) ? null : _model.AddressCounty,
                string.IsNullOrWhiteSpace(_model.AddressCountry) ? "GB" : _model.AddressCountry);
        }
        catch (ArgumentException ex)
        {
            _errorMessage = ex.Message;
            _isWorking = false;
            return;
        }

        var prefixes = (_model.PostcodePrefixesRaw ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var geography = GeoArea.FromPrefixes(prefixes);

        var command = new UpdateBranchCommand(BranchId, _model.Name, address, geography);

        var result = await BranchAdminService.UpdateAsync(command, CancellationToken.None);

        if (result.IsSuccess)
        {
            _successMessage = "Branch updated successfully.";
            await LoadAsync();
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isWorking = false;
    }

    private async Task ConfirmRetireAsync()
    {
        _isWorking = true;
        _confirmRetire = false;
        _errorMessage = null;
        _successMessage = null;

        var result = await BranchAdminService.RetireAsync(BranchId, CancellationToken.None);

        if (result.IsSuccess)
        {
            _successMessage = "Branch has been retired.";
            await LoadAsync();
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isWorking = false;
    }

    private async Task ReactivateAsync()
    {
        _isWorking = true;
        _errorMessage = null;
        _successMessage = null;

        var result = await BranchAdminService.ReactivateAsync(BranchId, CancellationToken.None);

        if (result.IsSuccess)
        {
            _successMessage = "Branch has been reactivated.";
            await LoadAsync();
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isWorking = false;
    }

    private sealed class BranchEditModel
    {
        [Required(ErrorMessage = "Branch name is required.")]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Address line 1 is required.")]
        [MaxLength(200)]
        public string AddressLine1 { get; set; } = string.Empty;

        [MaxLength(200)]
        public string? AddressLine2 { get; set; }

        [Required(ErrorMessage = "City is required.")]
        [MaxLength(100)]
        public string AddressCity { get; set; } = string.Empty;

        [MaxLength(100)]
        public string? AddressCounty { get; set; }

        [Required(ErrorMessage = "Postcode is required.")]
        [MaxLength(10)]
        public string AddressPostcode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Country is required.")]
        [MaxLength(2)]
        public string AddressCountry { get; set; } = "GB";

        public string? PostcodePrefixesRaw { get; set; }
    }
}
