@rendermode InteractiveServer
@page "/app/contacts"
@attribute [Authorize(Policy = PolicyNames.AnyStaff)]
@inject ContactService ContactService
@inject NavigationManager NavigationManager

<PageTitle>Contacts — Elect CRM</PageTitle>

<div class="page-header">
    <h1 class="page-header-title">Contacts</h1>
    <a href="/app/contacts/new" class="btn-dark">Add Contact</a>
</div>

@if (_errorMessage is not null)
{
    <div class="elect-alert elect-alert-error" role="alert">@_errorMessage</div>
}

@if (_confirmDeleteId.HasValue)
{
    <div class="elect-confirm-row">
        <span class="elect-confirm-row-msg">Delete this contact? This cannot be undone.</span>
        <button class="btn-danger" @onclick="ConfirmDeleteAsync">Delete</button>
        <button class="btn-outline" @onclick="CancelDelete">Cancel</button>
    </div>
}

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_result is not null && _result.TotalCount == 0)
{
    <div class="elect-empty-state">
        <p class="elect-empty-state-title">No contacts yet</p>
        <p class="elect-empty-state-body">Add your first contact to get started.</p>
        <a href="/app/contacts/new" class="btn-dark">Add Contact</a>
    </div>
}
else if (_result is not null)
{
    <div class="elect-table-wrap">
        <table class="elect-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th class="col-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in _result.Items)
                {
                    <tr @key="contact.Id">
                        <td><a href="/app/contacts/@contact.Id">@contact.FullName</a></td>
                        <td>@(contact.RoleTitle ?? "—")</td>
                        <td>@(contact.Email ?? "—")</td>
                        <td>@(contact.Phone ?? "—")</td>
                        <td>
                            <span class="elect-badge @(contact.Status == ContactStatus.Active ? "elect-badge-active" : "elect-badge-retired")">
                                @contact.Status
                            </span>
                        </td>
                        <td class="col-right">
                            <div class="elect-table-actions">
                                <a href="/app/contacts/@contact.Id/edit" class="btn-outline">Edit</a>
                                <button class="btn-danger" @onclick="() => RequestDelete(contact.Id)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="elect-pagination">
        <span class="elect-pagination-info">Page @_result.Page of @_result.TotalPages (@_result.TotalCount total)</span>
        <div class="elect-pagination-controls">
            <button class="btn-outline" @onclick="PreviousPage" disabled="@(!_result.HasPreviousPage)">Previous</button>
            <button class="btn-outline" @onclick="NextPage" disabled="@(!_result.HasNextPage)">Next</button>
        </div>
    </div>
}

@code {
    private int _page = 1;
    private const int PageSize = 25;
    private PagedResult<ContactSummaryDto>? _result;
    private bool _isLoading = true;
    private string? _errorMessage;
    private Guid? _confirmDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await ContactService.GetPagedAsync(null, _page, PageSize, CancellationToken.None);

        if (result.IsSuccess)
        {
            _result = result.Value;
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isLoading = false;
    }

    private async Task PreviousPage()
    {
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        _page++;
        await LoadAsync();
    }

    private void RequestDelete(Guid id)
    {
        _confirmDeleteId = id;
        _errorMessage = null;
    }

    private void CancelDelete()
    {
        _confirmDeleteId = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var result = await ContactService.DeleteAsync(_confirmDeleteId!.Value, CancellationToken.None);

        if (result.IsSuccess)
        {
            _confirmDeleteId = null;
            await LoadAsync();
        }
        else
        {
            _errorMessage = result.Error.Message;
        }
    }
}
