@rendermode InteractiveServer
@page "/app/candidates"
@attribute [Authorize(Policy = PolicyNames.AnyStaff)]
@inject CandidateService CandidateService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Candidates — Elect CRM</PageTitle>

<div class="page-header">
    <h1 class="page-header-title">Candidates</h1>
    <a href="/app/candidates/new" class="btn-dark">Add Candidate</a>
</div>

<div style="margin-bottom: var(--space-4); display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
    <input type="text" class="elect-input" placeholder="Search by name…"
           value="@_searchTerm" @oninput="OnSearchInput" style="max-width: 400px; flex: 1 1 240px;" />
    <select class="elect-input" style="max-width: 160px; flex: 0 0 auto;" @onchange="OnStatusChange">
        <option value="">All statuses</option>
        @foreach (var s in Enum.GetValues<CandidateStatus>())
        {
            <option value="@s">@s</option>
        }
    </select>
    <input type="text" class="elect-input" placeholder="Trade…"
           value="@_tradeFilter" @oninput="OnTradeInput" style="max-width: 180px; flex: 0 0 auto;" />
</div>

@if (_errorMessage is not null)
{
    <div class="elect-alert elect-alert-error" role="alert">@_errorMessage</div>
}

@if (_isLoading)
{
    <p>Loading…</p>
}
else if (_result is not null && _result.TotalCount == 0 && string.IsNullOrWhiteSpace(_searchTerm) && !_statusFilter.HasValue && string.IsNullOrWhiteSpace(_tradeFilter))
{
    <div class="elect-empty-state">
        <p class="elect-empty-state-title">No candidates yet</p>
        <p class="elect-empty-state-body">Add your first candidate to get started.</p>
        <a href="/app/candidates/new" class="btn-dark">Add Candidate</a>
    </div>
}
else if (_result is not null && _result.TotalCount == 0)
{
    <div class="elect-empty-state">
        <p>No candidates match your search.</p>
    </div>
}
else if (_result is not null)
{
    <div class="elect-table-wrap">
        <table class="elect-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Trade</th>
                    <th>Status</th>
                    <th>Consultant</th>
                    <th>Registered</th>
                    <th class="col-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in _result.Items)
                {
                    <tr @key="candidate.Id">
                        <td>
                            <a href="/app/candidates/@candidate.Id" class="elect-detail-link">@candidate.PersonDisplayName</a>
                        </td>
                        <td>@(candidate.PrimaryTrade ?? "—")</td>
                        <td>
                            <span class="elect-badge @(candidate.Status == CandidateStatus.Active ? "elect-badge-active" : "elect-badge-retired")">
                                @candidate.Status
                            </span>
                        </td>
                        <td>@(candidate.OwnerConsultantName ?? "—")</td>
                        <td>@candidate.RegistrationDate.ToString("d MMM yyyy")</td>
                        <td class="col-right">
                            <div class="elect-table-actions">
                                <a href="/app/candidates/@candidate.Id" class="btn-outline">View</a>
                                <a href="/app/candidates/@candidate.Id/edit" class="btn-outline">Edit</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="elect-pagination">
        <span class="elect-pagination-info">Page @_result.Page of @_result.TotalPages (@_result.TotalCount total)</span>
        <div class="elect-pagination-controls">
            <button class="btn-outline" @onclick="PreviousPage" disabled="@(!_result.HasPreviousPage)">Previous</button>
            <button class="btn-outline" @onclick="NextPage" disabled="@(!_result.HasNextPage)">Next</button>
        </div>
    </div>
}

@code {
    private int _page = 1;
    private const int PageSize = 25;
    private string _searchTerm = string.Empty;
    private string _tradeFilter = string.Empty;
    private CandidateStatus? _statusFilter;
    private PagedResult<CandidateSummaryDto>? _result;
    private bool _isLoading = true;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await CandidateService.SearchAsync(
            new CandidateSearchQuery(_searchTerm, _statusFilter, _tradeFilter, _page, PageSize),
            cancellationToken);

        if (result.IsSuccess)
        {
            _result = result.Value;
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isLoading = false;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(400, token);
            _page = 1;
            await LoadAsync(token);
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnTradeInput(ChangeEventArgs e)
    {
        _tradeFilter = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(400, token);
            _page = 1;
            await LoadAsync(token);
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnStatusChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _statusFilter = Enum.TryParse<CandidateStatus>(raw, out var parsed) ? parsed : null;
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPage()
    {
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        _page++;
        await LoadAsync();
    }

    public void Dispose()
    {
        _searchCts?.Dispose();
    }
}
