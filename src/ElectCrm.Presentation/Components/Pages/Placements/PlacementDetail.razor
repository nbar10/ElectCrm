    private async Task UpdateTermsAsync()
    {
        _termsSubmitting = true;
        _termsError = null;

        var command = new UpdatePlacementTermsCommand(
            _termsForm.PayRateAmount,
            string.IsNullOrWhiteSpace(_termsForm.PayRateCurrency) ? "GBP" : _termsForm.PayRateCurrency,
            _termsForm.EngagementType,
            _termsForm.HolidayPayInclusive,
            _termsForm.HolidayPayInclusive ? null : _termsForm.HolidayPayRate,
            _termsForm.BillRate,
            _termsForm.ProposedStartDate,
            _termsForm.ExpectedEndDate,
            _termsForm.HoursPerWeek);

        var result = await PlacementService.UpdateTermsAsync(Id, command, CancellationToken.None);

        _termsSubmitting = false;

        if (result.IsSuccess)
            await ReloadAsync();
        else
            _termsError = result.Error.Message;
    }

    private async Task UpdateOwnerAsync()
    {
        _reassignError = null;
        Guid? parsedGuid = Guid.TryParse(_reassignGuid, out var g) && g != Guid.Empty ? g : null;

        var result = await PlacementService.UpdateOwnerAsync(
            Id,
            new UpdatePlacementOwnerCommand(parsedGuid),
            CancellationToken.None);

        if (result.IsSuccess)
        {
            _reassignGuid = string.Empty;
            await ReloadAsync();
        }
        else
        {
            _reassignError = result.Error.Message;
        }
    }

    // DS-GAP-015 — status badge: 7 placement statuses need distinct badge variants; using closest available
    private static string PlacementBadgeClass(PlacementStatus status) => status switch
    {
        PlacementStatus.Offered         => "elect-badge elect-badge-warning",
        PlacementStatus.Accepted        => "elect-badge elect-badge-info",
        PlacementStatus.Active          => "elect-badge elect-badge-active",
        PlacementStatus.Completed       => "elect-badge elect-badge-active",
        PlacementStatus.TerminatedEarly => "elect-badge elect-badge-warning",
        PlacementStatus.Declined        => "elect-badge elect-badge-retired",
        PlacementStatus.Cancelled       => "elect-badge elect-badge-retired",
        _                               => "elect-badge"
    };
}
