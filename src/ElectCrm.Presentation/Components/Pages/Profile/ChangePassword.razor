@rendermode InteractiveServer
@page "/profile/change-password"
@layout MainLayout
@attribute [Authorize(Policy = PolicyNames.AnyStaff)]
@inject UserProfileService UserProfileService
@inject NavigationManager NavigationManager

<PageTitle>Change Password — Elect CRM</PageTitle>

<div class="page-header">
    <h1 class="page-header-title">Change Password</h1>
</div>

@if (_required)
{
    <div class="elect-alert elect-alert-warning" role="alert">
        You must set a new password before continuing. This temporary password cannot be used after this change.
    </div>
}

@if (_successMessage is not null)
{
    <div class="elect-alert elect-alert-success" role="alert">@_successMessage</div>
}

@if (_errorMessage is not null)
{
    <div class="elect-alert elect-alert-error" role="alert">@_errorMessage</div>
}

<div class="elect-card" style="max-width:480px">
    <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="elect-form-group">
            <label class="elect-label" for="current-password">Current Password</label>
            <InputText id="current-password" type="password" class="elect-input"
                       @bind-Value="_form.CurrentPassword" autocomplete="current-password" />
            <ValidationMessage For="() => _form.CurrentPassword" class="elect-field-error" />
        </div>

        <div class="elect-form-group">
            <label class="elect-label" for="new-password">New Password</label>
            <InputText id="new-password" type="password" class="elect-input"
                       @bind-Value="_form.NewPassword" autocomplete="new-password" />
            <ValidationMessage For="() => _form.NewPassword" class="elect-field-error" />
        </div>

        <div class="elect-form-group">
            <label class="elect-label" for="confirm-password">Confirm New Password</label>
            <InputText id="confirm-password" type="password" class="elect-input"
                       @bind-Value="_form.ConfirmNewPassword" autocomplete="new-password" />
            <ValidationMessage For="() => _form.ConfirmNewPassword" class="elect-field-error" />
        </div>

        <div class="elect-form-actions">
            <button type="submit" class="btn-gold" disabled="@_isSubmitting">
                @(_isSubmitting ? "Changing…" : "Change Password")
            </button>

            @if (!_required)
            {
                <a href="/profile" class="btn-outline">Cancel</a>
            }
            else
            {
                @* When forced, allow signing out so users aren't trapped if they need admin help *@
                <a href="/account/logout" class="btn-outline">Sign out</a>
            }
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromQuery(Name = "required")]
    public bool Required { get; set; }

    private readonly ChangePasswordFormModel _form = new();
    private bool _required;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnInitialized()
    {
        _required = Required;
    }

    private async Task HandleSubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        if (_form.NewPassword != _form.ConfirmNewPassword)
        {
            _errorMessage = "New password and confirmation do not match.";
            _isSubmitting = false;
            return;
        }

        var command = new ChangePasswordCommand(
            _form.CurrentPassword,
            _form.NewPassword,
            _form.ConfirmNewPassword);

        var result = await UserProfileService.ChangePasswordAsync(command);

        if (result.IsSuccess)
        {
            if (_required)
            {
                // Force-change path — send the user into the app now that the flag is cleared.
                NavigationManager.NavigateTo("/app", forceLoad: false);
            }
            else
            {
                // Normal self-service path — show success and stay.
                _successMessage = "Your password has been changed successfully.";
                _form.Reset();
            }
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isSubmitting = false;
    }

    private sealed class ChangePasswordFormModel
    {
        [Required(ErrorMessage = "Current password is required.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password.")]
        public string ConfirmNewPassword { get; set; } = string.Empty;

        public void Reset()
        {
            CurrentPassword = string.Empty;
            NewPassword = string.Empty;
            ConfirmNewPassword = string.Empty;
        }
    }
}
