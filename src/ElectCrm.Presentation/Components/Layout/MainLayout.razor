@inherits LayoutComponentBase
@using ElectCrm.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ElectCrmDbContext> DbContextFactory

<div class="shell">

    <aside class="shell-sidebar">
        <div class="shell-sidebar-brand">
            <span class="shell-brand-mark">Elect</span>
            <span class="shell-brand-sub">CRM</span>
        </div>

        <nav class="shell-nav" aria-label="Main navigation">
            <NavLink class="shell-nav-item" href="/app" Match="NavLinkMatch.All">
                <svg class="shell-nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.5L10 3l7 6.5V17a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/>
                    <path d="M7.5 18v-6h5v6"/>
                </svg>
                Home
            </NavLink>
            <NavLink class="shell-nav-item" href="/app/persons">
                <svg class="shell-nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="14" height="13" rx="2"/>
                    <circle cx="8" cy="9" r="2"/>
                    <path d="M4 17c0-2 1.8-3 4-3s4 1 4 3"/>
                    <path d="M13 8h3M13 11h2"/>
                </svg>
                Persons
            </NavLink>
            <NavLink class="shell-nav-item" href="/app/candidates">
                <svg class="shell-nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="10" cy="6" r="3"/>
                    <path d="M4 18c0-3.314 2.686-6 6-6s6 2.686 6 6"/>
                    <path d="M6.5 5.5C7 3.5 13 3.5 13.5 5.5"/>
                </svg>
                Candidates
            </NavLink>
            <NavLink class="shell-nav-item" href="/app/contacts">
                <svg class="shell-nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="8.5" cy="6" r="3"/>
                    <path d="M2 17c0-3.038 2.91-5.5 6.5-5.5s6.5 2.462 6.5 5.5"/>
                    <path d="M14 3.5a3 3 0 010 5M17.5 17c0-2.2-1.6-4.05-3.8-4.8"/>
                </svg>
                Contacts
            </NavLink>
            @if (_isGroupAdmin)
            {
                <NavLink class="shell-nav-item" href="/admin/brands">
                    <svg class="shell-nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10.5 3L17 6.5v7L10.5 17 4 13.5v-7L10.5 3z"/>
                        <path d="M10.5 3v14M4 6.5l6.5 4 6.5-4"/>
                    </svg>
                    Admin
                </NavLink>
            }
        </nav>
    </aside>

    <div class="shell-main">
        <header class="shell-header">
            <span class="shell-header-tenant">@_tenantName</span>
            <div class="shell-header-sep" role="separator" aria-hidden="true"></div>
            <span class="shell-header-user">@_userName</span>
            <div class="shell-header-sep" role="separator" aria-hidden="true"></div>
            <a href="/account/logout" class="shell-header-logout">Sign out</a>
        </header>

        <main class="shell-content" id="main-content">
            @Body
        </main>
    </div>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string _userName = string.Empty;
    private string _tenantName = string.Empty;
    private bool _isGroupAdmin;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _userName = auth.User.Identity?.Name ?? string.Empty;

        _isGroupAdmin = auth.User.Claims.Any(c =>
            c.Type == ElectClaimTypes.Role &&
            c.Value.Split(':')[0].Equals("GroupAdmin", StringComparison.Ordinal));

        await using var db = await DbContextFactory.CreateDbContextAsync();
        _tenantName = await db.AgencyBrands
            .Select(b => b.TradingName)
            .FirstOrDefaultAsync() ?? string.Empty;
    }
}
