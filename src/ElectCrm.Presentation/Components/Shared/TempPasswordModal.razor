@* Non-routable shared component — no @page directive *@

@* DESIGN_SYSTEM_GAP:DS-GAP-018 — Inline one-time password display.
   Replace with a shared secure-password-reveal design system component when available.
   Component must enforce: state-only storage, single-confirm dismissal, no logging,
   copy-to-clipboard. *@

@*
 * SECURITY: Password is held in this component's Parameter state only.
 * It is never sent back to the server after the parent receives it from the service.
 * The parent must clear its password field inside the OnDismiss callback.
 * Do not add features that could persist or transmit this value.
 *@

@inject IJSRuntime JS

@if (Password is not null)
{
    <div role="dialog" aria-modal="true" aria-labelledby="otp-modal-title"
         style="position: fixed; inset: 0; background: rgba(0,0,0,0.55); display: flex;
                align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: var(--bg-surface); border-radius: var(--radius-lg);
                    padding: var(--space-8); max-width: 520px; width: 100%;
                    box-shadow: var(--shadow-xl); margin: var(--space-4);">
            <h2 id="otp-modal-title" style="font-family: var(--font-display); font-size: 1.25rem;
                                             margin: 0 0 var(--space-2);">
                @Title
            </h2>
            <p style="font-size: 0.875rem; color: var(--fg-2); margin: 0 0 var(--space-4);">
                @Description
            </p>
            <div style="background: var(--bg-page); border: 1px solid var(--border-1);
                        border-radius: var(--radius-md); padding: var(--space-4);
                        margin-bottom: var(--space-4); text-align: center;">
                <code style="font-size: 1.125rem; letter-spacing: 0.05em; color: var(--fg-1);">
                    @Password
                </code>
            </div>
            <div style="display: flex; gap: var(--space-3);">
                <button class="btn-outline" @onclick="CopyAsync">Copy to clipboard</button>
                <button class="btn-gold" @onclick="DismissAsync">
                    @DismissLabel
                </button>
            </div>
            @if (_copied)
            {
                <p style="font-size: 0.8125rem; color: var(--success); margin-top: var(--space-2);">
                    Copied to clipboard.
                </p>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string? Password { get; set; }
    [Parameter] public string Title { get; set; } = "Temporary Password";
    [Parameter] public string Description { get; set; } = "Share this password securely with the user. It will not be shown again.";
    [Parameter] public string DismissLabel { get; set; } = "I have copied this password securely";
    [Parameter, EditorRequired] public EventCallback OnDismiss { get; set; }

    private bool _copied;

    private async Task CopyAsync()
    {
        if (Password is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            _copied = true;
        }
    }

    private async Task DismissAsync()
    {
        _copied = false;
        await OnDismiss.InvokeAsync();
    }
}
