@* App.razor — host page demonstrating the click-thru. *@
@* In a real Blazor project this would be MainLayout + page routes; here it's a single switchboard. *@

@if (!Authed)
{
    <Login OnLogin="() => Authed = true" />
}
else
{
    <div class="elect-layout">
        <Sidebar Active="@Route" OnNav="r => Route = r" />
        <main class="elect-main">
            @switch (Route)
            {
                case "dashboard":
                    <Dashboard Kpis="Kpis" Partners="PartnersData" Activity="ActivityFeed" />
                    break;
                case "partners":
                    <Partners Partners="PartnersData" />
                    break;
                case "plans":
                    <PlanBuilder Catalogue="Catalogue" Basket="Basket" BasketChanged="b => Basket = b" />
                    break;
                default:
                    <Topbar Title="@(char.ToUpper(Route[0]) + Route[1..])" />
                    <div class="elect-content">
                        <Card>
                            <ChildContent>
                                <div class="empty-state">
                                    <i class="bi bi-window-stack"></i>
                                    <h3>@Route screen</h3>
                                    <p>This screen is not part of the UI kit prototype.</p>
                                </div>
                            </ChildContent>
                        </Card>
                    </div>
                    break;
            }
        </main>
    </div>
}

